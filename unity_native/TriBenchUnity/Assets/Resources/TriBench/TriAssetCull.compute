#pragma kernel CullTriangles

StructuredBuffer<float> _Positions;
StructuredBuffer<int> _Indices;
RWStructuredBuffer<uint> _Visible;
uint _PrimitiveCount;
float4x4 _ViewProj;

[numthreads(128, 1, 1)]
void CullTriangles(uint id : SV_DispatchThreadID)
{
    if (id >= _PrimitiveCount) return;
    // A centroid-only frustum test incorrectly removes large triangles whose
    // center is outside the view but whose edges cover pixels. Until an exact
    // triangle/frustum overlap test is versioned and validated, keep the list
    // conservative: correctness takes precedence over this optional cull.
    _Visible[id] = id;
}
